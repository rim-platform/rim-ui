{
  "name": "@rim-platform/plugin-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for RIM plugin protocol v1",
  "license": "Apache-2.0",
  "homepage": "https://github.com/rim-platform/rim-ui/tree/master/sdk/plugin-sdk",
  "bugs": {
    "url": "https://github.com/rim-platform/rim-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rim-platform/rim-ui.git",
    "directory": "sdk/plugin-sdk"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "default": "./dist/index.browser.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "rim-plugin-bundle": "./dist/scripts/bundle-plugin.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "peerDependencies": {
    "esbuild": ">=0.25"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
