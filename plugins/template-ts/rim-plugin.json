{
  "manifest_version": 1,
  "plugin_id": "dev.example.template-ts",
  "display_name": "TypeScript Template",
  "version": "0.1.0",
  "description": "Starting point for a plugin written with the TypeScript SDK: one safe command and one dangerous one.",
  "author": "RIM team",
