{
  "name": "rim-ui",
  "private": true,
  "version": "0.0.1",
  "description": "RIM desktop and web client: a programmable communication workspace",
  "license": "Apache-2.0",
  "homepage": "https://github.com/rim-platform/rim-ui",
  "bugs": {
    "url": "https://github.com/rim-platform/rim-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rim-platform/rim-ui.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "codegen": "graphql-codegen --config codegen.mjs",
    "test": "vitest run",
    "test:wasm": "cd src-tauri && cargo test -p rim_mls -p rim_mls_wasm --no-default-features --target wasm32-unknown-unknown",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sdk:generate": "node sdk/plugin-sdk/scripts/generate-protocol.ts",
    "sdk:typecheck": "tsc -p sdk/plugin-sdk && tsc -p plugins/template-ts && tsc -p plugins/k8s-pods && tsc -p plugins/github-prs",
    "plugin:bundle": "node sdk/plugin-sdk/scripts/bundle-plugin.mjs",
    "skew:check": "node scripts/skew-check.mjs",
    "version:check": "node scripts/version-check.mjs",
    "version:set": "node scripts/version-set.mjs",
    "licenses": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@nozbe/microfuzz": "^1.0.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.14",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-log": "2.10.0",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.13.2",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "emoji-mart": "^5.6.0",
    "graphql": "^16.13.1",
    "graphql-request": "^7.4.0",
    "graphql-ws": "^6.3.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.577.0",
    "marked": "^17.0.5",
    "qrcode.react": "4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^29.0.1",
    "license-checker-rseidelsohn": "5.0.1",
    "msw": "^2.12.14",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.4",
    "vitest": "^4.1.2"
  }
}
