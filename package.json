{
  "name": "rim-ui",
  "private": true,
  "version": "0.0.12",
  "description": "RIM desktop and web client: a programmable communication workspace",
  "license": "Apache-2.0",
  "homepage": "https://github.com/rim-platform/rim-ui",
  "bugs": {
    "url": "https://github.com/rim-platform/rim-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rim-platform/rim-ui.git"
  },
  "type": "module",
  "workspaces": [
    "sdk/plugin-sdk"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "codegen": "graphql-codegen --config codegen.mjs",
    "test": "vitest run",
    "test:wasm": "cd src-tauri && cargo test -p rim_mls -p rim_mls_wasm -p rim_opaque -p rim_opaque_wasm --no-default-features --target wasm32-unknown-unknown",
    "test:watch": "vitest",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sdk:generate": "node sdk/plugin-sdk/scripts/generate-protocol.ts",
    "sdk:build": "node sdk/plugin-sdk/scripts/build.mjs",
    "sdk:typecheck": "npm run sdk:build && tsc -p sdk/plugin-sdk && tsc -p plugins/template-ts && tsc -p src-tauri/src/plugin_host/test_plugins/panel-ts",
    "sdk:smoke": "node scripts/sdk-smoke.mjs",
    "plugin:bundle": "node sdk/plugin-sdk/scripts/bundle-plugin.mjs",
    "skew:check": "node scripts/skew-check.mjs",
    "case:check": "node scripts/case-check.mjs",
    "version:check": "node scripts/version-check.mjs",
    "version:set": "node scripts/version-set.mjs",
    "licenses": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@nozbe/microfuzz": "^1.0.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-log": "2.10.1",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.14.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "emoji-mart": "^5.6.0",
    "graphql": "^16.13.1",
    "graphql-request": "^7.4.0",
    "graphql-ws": "^6.4.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "qrcode.react": "4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "license-checker-rseidelsohn": "5.0.1",
    "msw": "^3.0.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
